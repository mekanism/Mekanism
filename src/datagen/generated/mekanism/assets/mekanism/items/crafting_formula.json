          "model": "mekanism:item/crafting_formula_invalid"
        },
        "when": "invalid"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "mekanism:item/crafting_formula_encoded"
        },
        "when": "encoded"
      }
    ],
    "fallback": {
